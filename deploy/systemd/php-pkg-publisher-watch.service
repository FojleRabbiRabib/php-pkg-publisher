[Unit]
Description=Check the token, the origin certificate and the served repository dates
After=network-online.target
Wants=network-online.target
OnFailure=php-pkg-publisher-notify@%n.service

[Service]
Type=oneshot
User=php-pkg-publisher
Group=php-pkg-publisher
TimeoutStartSec=5min
WorkingDirectory=/opt/php-pkg-publisher
Environment=PYTHONPATH=/opt/php-pkg-publisher PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -s -m publisher.watch --config /etc/php-pkg-publisher/publisher.yml
# Only the alert memory is written, and it lives in the state directory.
ReadWritePaths=/var/lib/php-pkg-publisher/state
ReadOnlyPaths=/etc/php-pkg-publisher
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
