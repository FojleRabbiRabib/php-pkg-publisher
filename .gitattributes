# Normalize every text file to LF in the repository and the working tree.
* text=auto eol=lf

# Signed, compressed and packaged artifacts must stay byte-exact.
*.deb binary
*.gpg binary
*.gz binary
*.png binary
*.rpm binary
*.xz binary
*.zst binary

# Generated by pip-compile; collapsed in diffs.
requirements-dev.txt linguist-generated

# Signed bytes: the cosign bundle covers the exact file content.
tests/fixtures/sigstore/** -text
